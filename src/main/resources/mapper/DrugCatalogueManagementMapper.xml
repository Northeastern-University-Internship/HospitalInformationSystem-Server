<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.neuedu.His02.mapper.outpatientPharmacyWorkstationMapper.DrugCatalogueManagementMapper">

    <select id="selectAll" resultType="Drugs">
        select * from Drugs

        <where>

            <if test="DrugsName!=null and DrugsName!=''">
                and DrugsName like concat('%', #{DrugsName}, '%')
            </if>

        </where>
        order by ID desc
        limit 0,30
    </select>

    <select id="selectById" resultType="User">
        select * from User where ID=#{ID}
    </select>


    <insert id="add" useGeneratedKeys="true" keyProperty="ID">
        insert into Drugs(DrugsTypeID,CreationDate,DrugsCode,DrugsDosageID,DrugsFormat,DrugsName,DrugsPrice,DrugsUnit,Manufacturer,MnemonicCode)
        values(#{DrugsTypeID},#{CreationDate},#{DrugsCode},#{DrugsDosageID},#{DrugsFormat},#{DrugsName},#{DrugsPrice},#{DrugsUnit},#{Manufacturer},#{MnemonicCode})
    </insert>

    <update id="update">
        update Drugs set DrugsCode=#{DrugsCode},DrugsDosageID=#{DrugsDosageID}, DrugsFormat=#{DrugsFormat}, DrugsName=#{DrugsName}, DrugsPrice=#{DrugsPrice}, DrugsUnit=#{DrugsUnit}, Manufacturer=#{Manufacturer},MnemonicCode=#{MnemonicCode},LastUpdateDate=#{LastUpdateDate}
                         where ID=#{ID}
    </update>

    <update id="delete">
        update Drugs set DelMark = 0 where ID=#{ID}
    </update>

</mapper>
